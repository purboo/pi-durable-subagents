{
  "name": "pi-durable-subagents",
  "version": "1.0.10",
  "description": "Subagents for pi that never lose work and never do it twice. Crash-safe workflows, automatic recovery, and a live view just like the main agent.",
  "type": "module",
  "license": "MIT",
  "author": "purboo",
  "keywords": [
    "pi-package",
    "subagents",
    "workflow",
    "durable",
    "orchestration",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "pi-durable-subagents": "dist/cli/main.js"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "dist",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "test": "npm run test:unit && npm run test:pi",
    "test:unit": "node --test 'test/unit/**/*.test.ts'",
    "test:pi": "node --test --test-concurrency=1 'test/pi/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint:imports && npm test",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purboo/pi-durable-subagents.git"
  },
  "homepage": "https://github.com/purboo/pi-durable-subagents#readme",
  "bugs": {
    "url": "https://github.com/purboo/pi-durable-subagents/issues"
  }
}
